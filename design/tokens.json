{
  "$comment": "Phosphor design tokens: the single source for Lee (CSS), Aeronaut (Dart) and Dirigible (LVGL). Edit here, then run `node design/build.mjs`.",
  "color": {
    "ground-0": { "value": "#07110d", "role": "Terminal, T-Deck screen, deepest wells" },
    "ground-1": { "value": "#0a1410", "role": "Chrome: title, tab, status and nav bars" },
    "ground-2": { "value": "#0d1a14", "role": "Content background" },
    "ground-3": { "value": "#13261e", "role": "Raised: rows, cards, inputs, hover" },
    "ground-4": { "value": "#1a3028", "role": "Hairline borders, dividers" },
    "ground-5": { "value": "#2a4a3e", "role": "Strong borders, disabled fills, selected segments" },
    "text-1": { "value": "#e6f0eb", "role": "Primary text" },
    "text-2": { "value": "#9fbcb0", "role": "Secondary text, labels" },
    "text-3": { "value": "#6b8a7e", "role": "Muted text and hints" },
    "phosphor": { "value": "#44aa99", "role": "Brand, primary action, online, active" },
    "phosphor-hi": { "value": "#56bba9", "role": "Hover and pressed primary" },
    "phosphor-deep": { "value": "#2a7466", "role": "Shaded phosphor (illustration, muted fills)" },
    "on-phosphor": { "value": "#07110d", "role": "Text and icons on phosphor fills" },
    "lit": { "value": "#7fe0c0", "role": "Focus ring, cursor, selection, links" },
    "ember": { "value": "#f0a04b", "role": "Needs you: warnings, approvals, acting" },
    "error": { "value": "#e5604c", "role": "Errors, offline, destructive" },
    "info": { "value": "#6fb7d9", "role": "Neutral notices" }
  },
  "overlay": { "color": "#07110d", "opacity": 0.72 },
  "radius": { "tdeck": 2, "control": 4, "card": 8, "modal": 12 },
  "space": [0, 4, 8, 12, 16, 24, 32],
  "font": {
    "mono": "'JetBrains Mono', 'SF Mono', ui-monospace, Menlo, monospace",
    "ui": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif"
  },
  "ansi": {
    "black": "#1a3028", "red": "#e5604c", "green": "#44aa99", "yellow": "#f0a04b",
    "blue": "#6fb7d9", "magenta": "#c49bd9", "cyan": "#5cc8c0", "white": "#c4d8cf",
    "brightBlack": "#6b8a7e", "brightRed": "#f08a79", "brightGreen": "#7fe0c0", "brightYellow": "#f5c07f",
    "brightBlue": "#9fd4f0", "brightMagenta": "#dcbde9", "brightCyan": "#8fe3dc", "brightWhite": "#e6f0eb"
  }
}
